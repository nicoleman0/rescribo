# Copy to .env.production and fill in. See docs/DEPLOYMENT.md.
RESCRIBO_DOMAIN=rescribo.example.com
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
RESCRIBO_CREDENTIAL_KEY=
# Provider credentials; see docs/SETTINGS.md.
RESCRIBO_SLACK_APP_ID=
RESCRIBO_SLACK_CLIENT_ID=
RESCRIBO_SLACK_CLIENT_SECRET=
RESCRIBO_SLACK_SIGNING_SECRET=
RESCRIBO_GITHUB_APP_ID=
RESCRIBO_GITHUB_CLIENT_ID=
RESCRIBO_GITHUB_CLIENT_SECRET=
# GitHub App private key, one line only with literal \n between the PEM lines:
# RESCRIBO_GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# Above is an example, not a value; blank means GitHub is not configured. See docs/SETTINGS.md.
RESCRIBO_GITHUB_PRIVATE_KEY=
RESCRIBO_GITHUB_WEBHOOK_SECRET=
