{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rescribo.local/matching/contract/v1/request.schema.json",
  "title": "Matcher request, contract v1",
  "description": "One report and the ordered candidate problems Django retrieved for it. The serialized UTF-8 request must not exceed 65536 bytes; that limit is checked outside the schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "algorithm_version", "config_version", "report", "candidates"],
  "properties": {
    "contract_version": { "const": "1" },
    "algorithm_version": { "$ref": "#/$defs/version_name" },
    "config_version": { "$ref": "#/$defs/version_name" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "version": { "$ref": "#/$defs/row_version" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "uuid": {
      "description": "Canonical lowercase UUID. Ties break on this string in ascending order.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "row_version": { "type": "integer", "minimum": 1 },
    "version_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "summary", "linked_reports"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "version": { "$ref": "#/$defs/row_version" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "linked_reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
