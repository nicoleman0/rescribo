# Local development only. Run make bootstrap to generate a private .env.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=rescribo
POSTGRES_USER=rescribo
POSTGRES_PASSWORD=rescribo_dev
POSTGRES_PORT=55432
REDIS_PORT=56379
RESCRIBO_DATABASE_URL=postgresql://rescribo:rescribo_dev@127.0.0.1:55432/rescribo
RESCRIBO_REDIS_URL=redis://127.0.0.1:56379/0
# Slack, GitHub, and model credentials are not required for environment setup.
